root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,json,jsonc,yml,yaml,css,html,xml,svg}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.swift]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
