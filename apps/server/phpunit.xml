<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="random"
         resolveDependencies="true"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         failOnEmptyTestSuite="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true">

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!--
            The guarantees suite holds the product properties listed in docs/testing.md. It is separated so it
            can be run alone, and so that a reader can find every guarantee in one place.
        -->
        <testsuite name="guarantees">
            <directory>tests/Guarantee</directory>
        </testsuite>
    </testsuites>

    <!--
        Coverage covers the wiring as well as the classes. bootstrap/ and routes/ are executable PHP that the
        integration suite exists to protect; leaving them out of the measurement would report full coverage of
        the code least likely to be exercised by a unit test.
    -->
    <source>
        <include>
            <directory>src</directory>
            <directory>bootstrap</directory>
            <directory>routes</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="E_ALL"/>
        <env name="APP_ENV" value="testing"/>
        <!--
            The suite always targets its own database. `force` makes this win over the shell and over the
            environment file, because a suite that can be pointed at the development database by an exported
            variable is a suite that will one day truncate it. Host, port and credentials are still taken from
            the environment, so the same file serves a workstation and the pipeline.
        -->
        <env name="DB_DATABASE" value="bothdecks_test" force="true"/>
        <!--
            The application logs to standard error, and a test that asks for an unknown route makes it log a
            warning there. The mutation runner stops the whole initial run on the first byte of standard
            error, so only what the suite would want to see, an error, is logged while it runs.
        -->
        <env name="LOG_LEVEL" value="error" force="true"/>
        <!--
            The inspection screen starts closed in every test, whatever token a developer set locally to use
            it; the tests that need it open configure their own.
        -->
        <env name="TAXONOMY_INSPECTION_TOKEN" value="" force="true"/>
    </php>
</phpunit>
