# Copy to `.env` and fill in. The copy is ignored by git; this example is the only env file that is tracked.
#
# The application reads its environment from the process first and from `.env` second: a variable exported in
# the shell, or set on the FPM pool, always wins over the file. Every key here has a development default in
# `config/`, so an empty file is a valid file.

# Where the application runs. Anything but `local` and `testing` is treated as production for error display.
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080

# PostgreSQL 16 or later, with the `vector` and `postgis` extensions installed in the database.
# The test suite fixes its own database name (`bothdecks_test`) and reads the rest from here.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bothdecks
DB_USERNAME=bothdecks
DB_PASSWORD=

# 32 random bytes as 64 hexadecimal characters. Encryption, signing and replay protection derive from it, so
# it is generated once per environment and never reused between two:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
PULSAR_MASTER_KEY=

# The embedding model server the taxonomy reads vectors from (config/taxonomy.php names the model). On a
# workstation, `ollama` and a local runtime; in every hosted environment, `openai-compatible`, the address of
# a provider under European law, and the key it needs. See docs/taxonomy.md and
# docs/adr/0003-eu-only-model-inference.md.
TAXONOMY_EMBEDDING_PROVIDER=ollama
TAXONOMY_EMBEDDING_URL=http://127.0.0.1:11434
TAXONOMY_EMBEDDING_API_KEY=

# The taxonomy inspection screen exists only where this is set, at least 24 characters, and only for a
# request presenting it as the password of HTTP basic authentication. Leave empty to keep the screen closed.
TAXONOMY_INSPECTION_TOKEN=
